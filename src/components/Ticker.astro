---
interface Props {
  items: string[];
}
const { items } = Astro.props;
const doubled = [...items, ...items];
---

<div class="ticker">
  <div class="ticker-track">
    <div class="ticker-item">
      {doubled.map((item, i) => (
        <>
          <span>{item}</span>
          {i < doubled.length - 1 && <span class="dot">⚡</span>}
        </>
      ))}
    </div>
  </div>
</div>
