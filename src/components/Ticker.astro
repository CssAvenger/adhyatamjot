---
interface Props {
  items: string[];
  separator?: string;
}
const { items, separator = "⚡" } = Astro.props;
const doubled = [...items, ...items];
---

<div class="ticker">
  <div class="ticker-track">
    <div class="ticker-item">
      {doubled.map((item, i) => (
        <>
          <span>{item}</span>
          {i < doubled.length - 1 && <span class="dot">{separator}</span>}
        </>
      ))}
    </div>
  </div>
</div>