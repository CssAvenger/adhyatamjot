---
import Layout from "../layouts/Layout.astro";
import Ticker from "../components/Ticker.astro";
import { waLink, CONTACT, mailLink } from "../data/contact";
import { Image } from "astro:assets";

import keynoteHost from "../assets/images/emcee/black.jpg";
import weddingGala from "../assets/images/emcee/green.jpeg";
import videoSlot from "../assets/images/emcee/emcee23.mp4";

const tickerItems = [
  "COLLEGE FESTS",
  "AWARD NIGHTS",
  "PRODUCT LAUNCHES",
  "CROWD CONTROL",
  "BILINGUAL HOSTING",
  "STAGE CRAFT",
];

const roster = [
  {
    n: "01",
    title: "Corporate Summits & Town Halls",
    blurb:
      "Keynote intros, panel moderation, award handovers — timed to the second.",
  },
  {
    n: "02",
    title: "Cultural Festivals & College Fests",
    blurb:
      "High-decibel crowd work, artist introductions, seamless schedule recovery.",
  },
  {
    n: "03",
    title: "Weddings & Family Galas",
    blurb:
      "Warm, bilingual hosting in English, Hindi and Punjabi — every generation engaged.",
  },
  {
    n: "04",
    title: "Product Launches & Brand Nights",
    blurb:
      "Scripted precision with room for the unscripted moment that makes the night.",
  },
];

const instagramIcon = `
<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 512 512"
  width="18"
  height="18"
  fill="currentColor"
>
  <path
    fill-rule="nonzero"
    d="M170.663 256.157c-.083-47.121 38.055-85.4 85.167-85.483
    47.121-.092 85.407 38.03 85.499 85.16.091 47.129-38.047
    85.4-85.176 85.492-47.112.09-85.399-38.039-85.49-85.169zm-46.108.091
    c.141 72.602 59.106 131.327 131.69 131.186
    72.592-.141 131.35-59.09 131.209-131.692
    -.141-72.577-59.114-131.335-131.715-131.194
    -72.585.141-131.325 59.115-131.184 131.7zm237.104-137.091
    c.033 16.953 13.817 30.681 30.772 30.648
    16.961-.033 30.689-13.811 30.664-30.764
    -.033-16.954-13.818-30.69-30.78-30.657
    -16.962.033-30.689 13.818-30.656 30.773z
    M149.977 1.773c-27.239 1.285-45.843 5.648-62.101 12.018
    -16.829 6.561-31.095 15.354-45.286 29.604
    C28.381 57.653 19.655 71.944 13.144 88.79
    6.841 105.089 2.569 123.702 1.366 150.958
    -.102 178.264-.102 186.973.031 256.489
    .133 69.508.439 78.234 1.741 105.547
    1.302 27.231 5.649 45.828 12.019 62.093
    6.569 16.83 15.353 31.088 29.611 45.288
    14.25 14.201 28.55 22.918 45.404 29.438
    16.282 6.295 34.902 10.583 62.15 11.778
    27.305 1.203 36.022 1.468 105.521 1.335
    69.532-.132 78.25-.439 105.555-1.733
    27.239-1.303 45.826-5.665 62.1-12.019
    16.829-6.586 31.095-15.353 45.288-29.611
    14.191-14.251 22.917-28.55 29.428-45.405
    6.304-16.282 10.592-34.903 11.777-62.134
    1.195-27.322 1.478-36.048 1.344-105.556
    -.133-69.516-.447-78.225-1.741-105.523
    -1.294-27.255-5.657-45.844-12.019-62.118
    -6.577-16.829-15.352-31.079-29.602-45.287
    -14.25-14.192-28.55-22.935-45.404-29.429
    -16.29-6.305-34.903-10.601-62.15-11.779
    C333.747.164 325.03-.102 255.506.031
    c-69.507.133-78.224.431-105.529 1.742z"
  />
</svg>
`;

const micIcon = `
<svg
  xmlns="http://www.w3.org/2000/svg"
  width="18"
  height="18"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <path d="m11 7.601-5.994 8.19a1 1 0 0 0 .1 1.298l.817.818a1 1 0 0 0 1.314.087L15.09 12" />
  <path d="M16.5 21.174C15.5 20.5 14.372 20 13 20c-2.058 0-3.928 2.356-6 2-2.072-.356-2.775-3.369-1.5-4.5" />
  <circle cx="16" cy="7" r="5" />
</svg>
`;
---

<Layout
  title="Event Emcee & Host — Corporate, Weddings & Festivals | Adhyatamjot Singh"
  description="Book Adhyatamjot Singh as your event emcee — bilingual hosting for corporate summits, college fests, weddings and product launches, with crowd control and stage craft honed over years on the mic."
  path="/emcee"
>
  <div class="emcee-theme">

    <!-- HERO -->
    <section class="hero stage-hero">
      <div class="stage-glow"></div>
      <div class="stage-beams"></div>

      <div class="container hero-inner reveal">
        <p class="hero-kicker">The Emcee</p>

        <h1 class="main-heading">
          Commanding rooms,
          <br />
          <span class="highlight">one word at a time.</span>
        </h1>

        <p class="hero-sub">
          Corporate summits, cultural festivals, weddings and brand nights —
          hosted with timing, warmth and just the right amount of trouble.
          English, Hindi and Punjabi on tap.
        </p>

        <div class="hero-cta-row">
          <a
            class="btn btn-primary"
            href={waLink("Hey, I'm interested in booking you for an event.")}
          >
            Check Availability
          </a>

          <a class="btn btn-ghost" href="#contact">
            Get in touch
          </a>
        </div>
      </div>

      <Ticker items={tickerItems} separator="✦" />
    </section>


    <!-- EVENT ROSTER -->
    <section class="section-pad" id="roster">
      <div class="container">

        <p class="eyebrow reveal">
          M.01 — Event Roster
        </p>

        <h2 class="section-title reveal">
          Rooms I've held, formats I own.
        </h2>

        <div
          style="display:flex; flex-direction:column; gap:14px; margin-top:44px;"
        >
          {
            roster.map((r) => (
              <div class="card roster-row reveal">

                <div class="roster-row-left">

                  <span
                    class="icon-badge"
                    style="margin:0; flex-shrink:0;"
                    set:html={micIcon}
                  />

                  <div>
                    <h3 style="margin-bottom:4px;">
                      {r.title}
                    </h3>

                    <p style="margin:0;">
                      {r.blurb}
                    </p>
                  </div>

                </div>

                <span class="card-index roster-number">
                  {r.n}
                </span>

              </div>
            ))
          }
        </div>

      </div>
    </section>


    <!-- ON STAGE -->
    <section
      class="section-pad"
      style="background:var(--bg-soft); border-block:1px solid var(--panel-border);"
      id="on-stage"
    >
      <div class="container">

        <p class="eyebrow reveal">
          M.02 — On Stage
        </p>

        <h2 class="section-title reveal">
          Spotlights, punchlines and full houses.
        </h2>

        <p class="section-intro reveal">
          Dashed frames and showreel slots are reserved placeholders —
          drop in your stage photos and hosting videos anytime.
        </p>

        <div class="gallery">

          <!-- PHOTO -->
          <div class="gallery-item tall reveal">

            <Image
              src={keynoteHost}
              alt="Keynote host silhouetted on stage at a tech summit"
              width={480}
              height={620}
            />

            <div class="gallery-caption">
              <span class="label">
                Keynote Host &amp; Tech Summit Anchor
              </span>

              <span class="pill-tag">
                Corporate
              </span>
            </div>

          </div>


          <!-- VIDEO -->
          <div class="gallery-item mid placeholder reveal">

            <div class="gallery-video">

              <video
                id="video-player"
                playsinline
                loop
              >
                <source
                  src={videoSlot}
                  type="video/mp4"
                />
              </video>

              <span
                class="pill-tag"
                style="align-self:flex-start;"
              >
                Video Slot
              </span>

              <span class="filename">
                SHOWREEL_01.MP4
              </span>

              <button
                type="button"
                class="play"
                id="video-btn"
                aria-label="Play video"
              >
                <svg
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  aria-hidden="true"
                >
                  <path d="M8 5v14l11-7z" />
                </svg>
              </button>

              <small style="text-align:center;">
                Your hosting showreel — embed the crowd-moment video
              </small>

            </div>

          </div>


          <!-- WEDDING -->
          <div class="gallery-item tall reveal">

            <Image
              src={weddingGala}
              alt="Wedding gala host with a microphone"
              width={480}
              height={620}
            />

            <div class="gallery-caption">
              <span class="label">
                Wedding Gala Host
              </span>

              <span class="pill-tag">
                Weddings
              </span>
            </div>

          </div>
          
        </div>

<a
          class="btn btn-primary" id="see-more-btn"
          href={CONTACT.instagram}
          style="margin: 30px auto !important; display:block; margin: auto; text-align:center;"
        >
          See more Videos & Photos

          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
          >
            <path
              d="M5 12h14M13 6l6 6-6 6"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </a>
      </div>
    </section>


    <!-- WHY ME -->
    <section class="section-pad" id="why-me">
      <div class="container">

        <p class="eyebrow reveal">
          M.03 — Why Me
        </p>

        <h2 class="section-title reveal">
          Part script, part improv, always on beat.
        </h2>

        <div
          class="card-grid"
          style="grid-template-columns:repeat(3,1fr); margin-top:44px;"
        >

          <div class="card reveal">
            <h3>
              Three languages, one mic
            </h3>

            <p>
              English, Hindi and Punjabi hosting means no table in the room
              feels left out — grandparents included.
            </p>
          </div>


          <div class="card reveal">
            <h3>
              Performer's instinct
            </h3>

            <p>
              Years on stage as a dancer taught me how to read a crowd's
              energy and adjust the pace in real time.
            </p>
          </div>


          <div class="card reveal">
            <h3>
              Runs on time, every time
            </h3>

            <p>
              Event managers love working with me because the schedule I'm
              handed is the schedule that actually happens.
            </p>
          </div>

        </div>

      </div>
    </section>


    <!-- CTA -->
    <section class="cta-band curtain">

      <div class="container reveal">

        <h2>
          Your event deserves a voice, not a script.
        </h2>

        <p>
          Tell me the date, the city and the crowd — I'll handle the rest
          of the room.
        </p>

        <a
          class="btn btn-primary"
          href={waLink("Hey, I'm interested in booking you for an event.")}
          style="margin-top:30px;"
        >
          Book the Mic

          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
          >
            <path
              d="M5 12h14M13 6l6 6-6 6"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </a>

      </div>

    </section>


    <!-- CONTACT -->
    <section
      class="cta-band"
      id="contact"
      aria-labelledby="contact-title"
    >

      <div class="container reveal">

        <p
          class="eyebrow"
          style="justify-content:center;"
        >
          05 // Contact
        </p>

        <h2 id="contact-title">
          Hiring a lead or building something reliable? Let's talk.
        </h2>

        <p>
          Send an email or start a quick WhatsApp chat — whichever suits you.
        </p>


        <address
          class="contact-grid"
          style="max-width:720px; margin-inline:auto; text-align:left; font-style:normal;"
        >

          <!-- INSTAGRAM -->
          <a
            class="contact-card"
            href={CONTACT.instagram}
            target="_blank"
            rel="noopener noreferrer"
          >

            <span class="contact-left">

              <span
                class="contact-icon"
                set:html={instagramIcon}
              />

              <span>
                <span class="title">
                  Instagram
                </span>

                <span class="value">
                  @addy_khatri01
                </span>
              </span>

            </span>

          </a>


          <!-- WEBSITE -->
          <a
            class="contact-card"
            href={CONTACT.liveSite}
            target="_blank"
            rel="noopener noreferrer"
          >

            <span class="contact-left">

              <span class="contact-icon">

                <svg
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  aria-hidden="true"
                >
                  <circle cx="12" cy="12" r="10" />
                  <path d="M2 12h20" />
                  <path d="M12 2a15.3 15.3 0 0 1 0 20 15.3 15.3 0 0 1 0-20Z" />
                </svg>

              </span>

              <span>
                <span class="title">
                  Website
                </span>

                <span class="value">
                  adhyatamjot-singh.eu.org
                </span>
              </span>

            </span>

          </a>


          <!-- EMAIL -->
          <a
            class="contact-card"
            href={mailLink("Project or hiring enquiry")}
          >

            <span class="contact-left">

              <span class="contact-icon">

                <svg
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  aria-hidden="true"
                >
                  <rect
                    x="2"
                    y="4"
                    width="20"
                    height="16"
                    rx="2"
                  />
                  <path d="m2 7 10 6 10-6" />
                </svg>

              </span>

              <span>
                <span class="title">
                  Email
                </span>

                <span class="value">
                  {CONTACT.email}
                </span>
              </span>

            </span>

          </a>


          <!-- WHATSAPP -->
          <a
            class="contact-card"
            href={waLink(
              "Hi Adhyatamjot, I came across your portfolio and would like to talk about a project or role."
            )}
            target="_blank"
            rel="noopener noreferrer"
          >

            <span class="contact-left">

              <span class="contact-icon">

                <svg
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  aria-hidden="true"
                >
                  <path d="M17.5 14.4c-.3-.1-1.7-.8-1.9-.9-.3-.1-.4-.1-.6.1-.2.3-.7.9-.8 1-.2.2-.3.2-.5.1-.3-.1-1.2-.4-2.3-1.4-.8-.7-1.4-1.6-1.6-1.9-.2-.3 0-.5.1-.6l.4-.5c.1-.1.2-.3.2-.4.1-.1.1-.3 0-.4-.1-.1-.6-1.4-.8-1.9-.2-.5-.4-.4-.6-.4h-.5c-.2 0-.5.1-.7.3-.3.3-1 1-1 2.3 0 1.4 1 2.7 1.1 2.9.1.2 2 3.1 4.9 4.3.7.3 1.2.5 1.7.6.7.2 1.3.2 1.8.1.5-.1 1.7-.7 1.9-1.3.2-.7.2-1.2.2-1.3-.1-.2-.3-.3-.6-.4Z" />
                  <path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Z" />
                </svg>

              </span>

              <span>
                <span class="title">
                  WhatsApp
                </span>

                <span class="value">
                  Start a chat
                </span>
              </span>

            </span>

          </a>


          <!-- LOCATION -->
          <div
            class="contact-card"
            style="cursor:default; grid-column:1 / -1;"
          >

            <span class="contact-left">

              <span class="contact-icon">

                <svg
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  aria-hidden="true"
                >
                  <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" />
                  <circle cx="12" cy="10" r="3" />
                </svg>

              </span>

              <span>
                <span class="title">
                  Based in
                </span>

                <span class="value">
                  {CONTACT.base}
                </span>
              </span>

            </span>

          </div>

        </address>

      </div>

    </section>

  </div>


  <!-- VIDEO SCRIPT -->
  <script>
    const videoPlayer =
      document.querySelector<HTMLVideoElement>("#video-player");

    const playBtn =
      document.querySelector<HTMLButtonElement>("#video-btn");

    if (videoPlayer && playBtn) {

      playBtn.addEventListener("click", async () => {

        if (videoPlayer.paused) {

          try {
            await videoPlayer.play();

            playBtn.innerHTML = `
              <svg
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="currentColor"
                aria-hidden="true"
              >
                <path d="M6 5h4v14H6zM14 5h4v14h-4z" />
              </svg>
            `;

            playBtn.setAttribute("aria-label", "Pause video");

          } catch (error) {
            console.error("Video could not be played:", error);
          }

        } else {

          videoPlayer.pause();

          playBtn.innerHTML = `
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path d="M8 5v14l11-7z" />
            </svg>
          `;

          playBtn.setAttribute("aria-label", "Play video");
        }

      });


      /*
       * Keep the icon synchronized if the video
       * is paused/played by something other than
       * the custom button.
       */

      videoPlayer.addEventListener("play", () => {

        playBtn.innerHTML = `
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
          >
            <path d="M6 5h4v14H6zM14 5h4v14h-4z" />
          </svg>
        `;

        playBtn.setAttribute("aria-label", "Pause video");
      });


      videoPlayer.addEventListener("pause", () => {

        playBtn.innerHTML = `
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
          >
            <path d="M8 5v14l11-7z" />
          </svg>
        `;

        playBtn.setAttribute("aria-label", "Play video");
      });

    }
  </script>
</Layout>


<style>
  /* -------------------------------------------------------
     Warm "on stage" theme
  ------------------------------------------------------- */

  .emcee-theme {
    --accent: #e7b25c;
    --accent-soft: rgba(231, 178, 92, 0.14);
    --accent-glow: rgba(231, 178, 92, 0.38);

    --panel: #16110c;
    --panel-border: rgba(255, 222, 179, 0.1);
    --panel-border-hover: rgba(231, 178, 92, 0.4);

    --bg-soft: #120d09;

    --font-heading: "Fraunces", Georgia, serif;
    --font-mono: "Fraunces", Georgia, serif;
  }


  .emcee-theme h1,
  .emcee-theme h2,
  .emcee-theme h3 {
    font-weight: 600;
    letter-spacing: -0.01em;
  }


  .emcee-theme .eyebrow,
  .emcee-theme .pill-tag,
  .emcee-theme .card-index,
  .emcee-theme .ticker-item,
  .emcee-theme .gallery-video .filename,
  .emcee-theme .gallery-video small {
    font-style: italic;
    letter-spacing: 0.04em;
  }


  .emcee-theme .btn {
    font-style: normal;
    letter-spacing: 0.02em;
  }


  .emcee-theme .btn-primary {
    color: #2b1706;
  }


  .emcee-theme .highlight {
    color: var(--accent);
    font-style: italic;
  }


  /* -------------------------------------------------------
     HERO
  ------------------------------------------------------- */

  .stage-hero {
    position: relative;
    padding-bottom: 0;
    text-align: center;
  }


  .stage-hero .bg-grid,
  .stage-hero .bg-glow {
    display: none;
  }


  .stage-glow {
    position: absolute;
    inset: 0;

    background:
      radial-gradient(
        ellipse 55% 60% at 50% 0%,
        rgba(231, 178, 92, 0.32),
        transparent 70%
      );

    pointer-events: none;
  }


  .stage-beams {
    position: absolute;
    inset: 0;
    opacity: 0.55;
    pointer-events: none;

    background-image:
      linear-gradient(
        100deg,
        transparent 44%,
        rgba(255, 232, 196, 0.09) 49%,
        transparent 54%
      ),
      linear-gradient(
        78deg,
        transparent 58%,
        rgba(255, 232, 196, 0.07) 63%,
        transparent 68%
      );
  }


  .stage-hero .hero-inner {
    position: relative;
  }


  .stage-hero h1 {
    font-style: italic;
  }


  /* -------------------------------------------------------
     ROSTER
  ------------------------------------------------------- */

  .roster-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }


  .roster-row-left {
    display: flex;
    align-items: center;
    gap: 22px;
  }


  .roster-number {
    font-size: 26px;
    opacity: 0.5;
  }


  /* -------------------------------------------------------
     VIDEO
  ------------------------------------------------------- */

  .gallery-video {
    position: relative;
    overflow: hidden;
    min-height: 280px;

    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 16px;
  }


  .gallery-video video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }


  .gallery-video::after {
    content: "";
    position: absolute;
    inset: 0;

    background: rgba(0, 0, 0, 0.3);

    pointer-events: none;

    z-index: 1;
  }


  .gallery-video .pill-tag,
  .gallery-video .filename,
  .gallery-video .play,
  .gallery-video small {
    position: relative;
    z-index: 2;
  }


  .gallery-video .filename {
    display: block;
  }


  .gallery-video small {
    display: block;
  }


  .gallery-video .play {
    align-self: center;

    width: 54px;
    height: 54px;

    border: 1px solid rgba(255, 255, 255, 0.35);
    border-radius: 50%;

    background: rgba(0, 0, 0, 0.45);
    color: white;

    display: flex;
    align-items: center;
    justify-content: center;

    cursor: pointer;

    transition:
      transform 0.2s ease,
