---
import Layout from "../layouts/Layout.astro";
import Ticker from "../components/Ticker.astro";
import { waLink, CONTACT, mailLink } from "../data/contact";
import { Image } from "astro:assets";

import keynoteHost from "../assets/images/emcee/black.jpg";
import weddingGala from "../assets/images/emcee/green.jpeg";
import singlingB from "../assets/images/emcee/emceeb.jpeg"
import videoSlot from "../assets/images/emcee/emcee23.mp4";
import akhadaSlot from "../assets/images/emcee/akhada.mp4";
import boliSlot from "../assets/images/emcee/boli.mp4";

const pageTitle =
  "Emcee & Anchor in Delhi NCR | Weddings, Sangeets, Corporate Events | Adhyatamjot Singh";
const pageDescription =
  "Delhi-based emcee and anchor for sangeets, weddings, corporate events, college fests and dance competitions. Hosts in Hindi, English and Punjabi. Travels across India.";

const tickerItems = [
  "SANGEETS & WEDDINGS",
  "CORPORATE EVENTS",
  "DANCE COMPETITIONS",
  "COLLEGE FESTS",
  "LIVE BAND NIGHTS",
  "HINDI · ENGLISH · PUNJABI",
];

const stats = [
  { value: "50+", label: "live shows on stage with multiple DJ Based Bands" },
  { value: "3", label: "languages: Hindi, English, Punjabi" },
  { value: "Pan-India", label: "based in Delhi, happy to travel" },
];

const roster = [
  {
    title: "Weddings & Sangeets",
    blurb:
      "Family introductions, couple games, dance-off moments and smooth transitions. Everyone from the dadi to the college cousins stays part of the night.",
  },
  {
    title: "Dance Competitions & Talent Shows",
    blurb:
      "I've hosted dance competitions, so I know how to build up a performance, keep judges and schedules on track, and keep the audience loud between acts.",
  },
  {
    title: "Corporate Events & Award Nights",
    blurb:
      "Annual days, town halls, panels and award handovers. Clear, warm and on time, with enough energy to wake up a post-lunch room.",
  },
  {
    title: "College Fests & Cultural Nights",
    blurb:
      "Big crowds, tight schedules and artist introductions. I stay calm when a slot shifts and keep the crowd with us.",
  },
  {
    title: "Live Band & Concert Nights",
    blurb:
      "After 50+ shows in multiple DJ Based Bands, I know how to work with sound, lights and musicians, and how to keep a packed floor moving.",
  },
  {
    title: "Product Launches & Brand Nights",
    blurb:
      "A scripted flow that respects your brand, with room for the unscripted moment people remember.",
  },
];

const steps = [
  {
    title: "Tell me about the event",
    text: "Share the date, city, venue, crowd and the kind of evening you want. A quick WhatsApp message is enough.",
  },
  {
    title: "We plan the flow together",
    text: "I read your run-of-show, suggest games or segments if you'd like them, and write the script with you.",
  },
  {
    title: "I show up early and host",
    text: "Sound check, a word with the DJ and the planner, and then I take care of the mic so you can enjoy your event.",
  },
];

const faqs = [
  {
    q: "Which languages do you host in?",
    a: "Hindi, English and Punjabi. I switch between them as the crowd needs, so guests of every age feel included.",
  },
  {
    q: "Do you travel outside Delhi?",
    a: "Yes. I'm based in New Delhi and happy to host destination weddings and corporate events in other cities, including Jaipur, Udaipur and Jodhpur. Travel and stay are usually arranged by the client.",
  },
  {
    q: "What kinds of events do you host?",
    a: "Weddings and sangeets, corporate events and award nights, college fests, dance competitions, live band nights and product launches.",
  },
  {
    q: "How far ahead should I book?",
    a: "As early as you can, especially for wedding season weekends and festival dates. If your date is close, message me anyway and I'll tell you honestly whether I'm free.",
  },
  {
    q: "How much does it cost?",
    a: "It depends on the event type, duration, city and how much planning is involved. Send me the details on WhatsApp and I'll reply with a clear quote.",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ProfessionalService",
      name: "Adhyatamjot Singh, Event Emcee & Anchor",
      description: pageDescription,
      url: `${CONTACT.liveSite}/emcee`,
      image: `${CONTACT.liveSite}/og-image.jpg`,
      sameAs: [CONTACT.instagram],
      areaServed: [
        { "@type": "City", name: "Delhi" },
        { "@type": "AdministrativeArea", name: "Delhi NCR" },
        { "@type": "AdministrativeArea", name: "Rajasthan" },
        { "@type": "Country", name: "India" },
      ],
      knowsLanguage: ["Hindi", "English", "Punjabi"],
      serviceType: [
        "Wedding emcee",
        "Sangeet anchor",
        "Corporate event host",
        "College fest anchor",
        "Dance competition host",
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: faqs.map((f) => ({
        "@type": "Question",
        name: f.q,
        acceptedAnswer: { "@type": "Answer", text: f.a },
      })),
    },
  ],
};

const instagramIcon = `
<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 512 512"
  width="18"
  height="18"
  fill="currentColor"
>
  <path
    fill-rule="nonzero"
    d="M170.663 256.157c-.083-47.121 38.055-85.4 85.167-85.483
    47.121-.092 85.407 38.03 85.499 85.16.091 47.129-38.047
    85.4-85.176 85.492-47.112.09-85.399-38.039-85.49-85.169zm-46.108.091
    c.141 72.602 59.106 131.327 131.69 131.186
    72.592-.141 131.35-59.09 131.209-131.692
    -.141-72.577-59.114-131.335-131.715-131.194
    -72.585.141-131.325 59.115-131.184 131.7zm237.104-137.091
    c.033 16.953 13.817 30.681 30.772 30.648
    16.961-.033 30.689-13.811 30.664-30.764
    -.033-16.954-13.818-30.69-30.78-30.657
    -16.962.033-30.689 13.818-30.656 30.773z
    M149.977 1.773c-27.239 1.285-45.843 5.648-62.101 12.018
    -16.829 6.561-31.095 15.354-45.286 29.604
    C28.381 57.653 19.655 71.944 13.144 88.79
    6.841 105.089 2.569 123.702 1.366 150.958
    -.102 178.264-.102 186.973.031 256.489
    .133 69.508.439 78.234 1.741 105.547
    1.302 27.231 5.649 45.828 12.019 62.093
    6.569 16.83 15.353 31.088 29.611 45.288
    14.25 14.201 28.55 22.918 45.404 29.438
    16.282 6.295 34.902 10.583 62.15 11.778
    27.305 1.203 36.022 1.468 105.521 1.335
    69.532-.132 78.25-.439 105.555-1.733
    27.239-1.303 45.826-5.665 62.1-12.019
    16.829-6.586 31.095-15.353 45.288-29.611
    14.191-14.251 22.917-28.55 29.428-45.405
    6.304-16.282 10.592-34.903 11.777-62.134
    1.195-27.322 1.478-36.048 1.344-105.556
    -.133-69.516-.447-78.225-1.741-105.523
    -1.294-27.255-5.657-45.844-12.019-62.118
    -6.577-16.829-15.352-31.079-29.602-45.287
    -14.25-14.192-28.55-22.935-45.404-29.429
    -16.29-6.305-34.903-10.601-62.15-11.779
    C333.747.164 325.03-.102 255.506.031
    c-69.507.133-78.224.431-105.529 1.742z"
  />
</svg>
`;

const micIcon = `
<svg
  xmlns="http://www.w3.org/2000/svg"
  width="18"
  height="18"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <path d="m11 7.601-5.994 8.19a1 1 0 0 0 .1 1.298l.817.818a1 1 0 0 0 1.314.087L15.09 12" />
  <path d="M16.5 21.174C15.5 20.5 14.372 20 13 20c-2.058 0-3.928 2.356-6 2-2.072-.356-2.775-3.369-1.5-4.5" />
  <circle cx="16" cy="7" r="5" />
</svg>
`;

const bookMsg =
  "Hi Adhyatamjot, I'd like to check your availability for an event. Date: , City: , Event type: ";
---

<Layout
  title={pageTitle}
  description={pageDescription}
  path="/emcee"
>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <div class="emcee-theme">

    <!-- HERO -->
    <section class="hero stage-hero">
      <div class="stage-glow"></div>
      <div class="stage-beams"></div>

      <div class="container hero-inner reveal">
        <p class="hero-kicker">Event emcee &amp; anchor in Delhi NCR</p>

        <h1 class="main-heading">
          The host who keeps
          <br />
          <span class="highlight">your whole room with you.</span>
        </h1>

        <p class="hero-sub">
          I'm Adhyatamjot, a Delhi-based emcee for sangeets, weddings,
          corporate evenings, college fests and dance competitions. After 50+
          live shows on stage with multiple DJ Based Bands, a big, loud crowd is where I'm
          most at home. I host in Hindi, English and Punjabi.
        </p>

        <div class="hero-cta-row">
          <a class="btn btn-primary" href={waLink(bookMsg)}>
            Check my date on WhatsApp
          </a>

          <a class="btn btn-ghost" href="#on-stage">
            Watch me host
          </a>
        </div>

        <ul class="stat-row" aria-label="Quick facts">
          {
            stats.map((s) => (
              <li>
                <strong>{s.value}</strong>
                <span>{s.label}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <Ticker items={tickerItems} separator="✦" />
    </section>


    <!-- ON STAGE (moved up for first impression) -->
    <section
      class="section-pad"
      style="background:var(--bg-soft); border-block:1px solid var(--panel-border);"
      id="on-stage"
    >
      <div class="container">

        <h2 class="section-title reveal">
          See how a room feels when I'm on the mic.
        </h2>

        <p class="section-intro reveal">
          A few moments from the stage. Tap play on the video to see me work a
          live crowd, and visit Instagram for more full-length clips.
        </p>

        <div class="gallery">
          <div class="gallery-item mid reveal">
            <div class="gallery-video">
              <video
                class="video-player"
                playsinline
                loop
                preload="metadata"
                aria-label="Adhyatamjot Singh hosting a live crowd"
              >
                <source src={videoSlot} type="video/mp4" />
              </video>

              <span class="pill-tag" style="align-self:flex-start;">
                Live crowd
              </span>

              <button
                type="button"
                class="play"
                aria-label="Play video"
              >
                <svg
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  aria-hidden="true"
                >
                  <path d="M8 5v14l11-7z" />
                </svg>
              </button>

              <span class="label" style="position:relative; z-index:2;">
                Working a live crowd
              </span>
            </div>
          </div>
          <div class="gallery-item mid reveal">
            <div class="gallery-video">
              <video
                class="video-player"
                playsinline
                loop
                preload="metadata"
                aria-label="Adhyatamjot Singh hosting a live crowd"
              >
                <source src={akhadaSlot} type="video/mp4" />
              </video>

              <span class="pill-tag" style="align-self:flex-start;">
                Dance Competition
              </span>

              <button
                type="button"
                class="play"
                aria-label="Play video"
              >
                <svg
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  aria-hidden="true"
                >
                  <path d="M8 5v14l11-7z" />
                </svg>
              </button>

              <span class="label" style="position:relative; z-index:2;">
                Hosting a dance competition
              </span>
            </div>
          </div>
          <div class="gallery-item mid reveal">
            <div class="gallery-video">
              <video
                class="video-player"
                playsinline
                loop
                preload="metadata"
                aria-label="Adhyatamjot Singh hosting a live crowd"
              >
                <source src={boliSlot} type="video/mp4" />
              </video>

              <span class="pill-tag" style="align-self:flex-start;">
                Wedding Fun
              </span>

              <button
                type="button"
                class="play"
                aria-label="Play video"
              >
                <svg
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  aria-hidden="true"
                >
                  <path d="M8 5v14l11-7z" />
                </svg>
              </button>

              <span class="label" style="position:relative; z-index:2;">
                Hyping up a wedding crowd
              </span>
            </div>
          </div>


        </div>

        <div class="gallery">

          <div class="gallery-item tall reveal">
            <Image
              src={keynoteHost}
              alt="Adhyatamjot Singh hosting a corporate summit on stage"
              width={480}
              height={620}
              loading="lazy"
            />
            <div class="gallery-caption">
              <span class="label">Hosting a corporate summit</span>
              <span class="pill-tag">Corporate</span>
            </div>
          </div>

          <div class="gallery-item tall reveal">
            <Image
              src={weddingGala}
              alt="Adhyatamjot Singh hosting a wedding celebration with a microphone"
              width={480}
              height={620}
              loading="lazy"
            />
            <div class="gallery-caption">
              <span class="label">Hosting a wedding celebration</span>
              <span class="pill-tag">Weddings</span>
            </div>
          </div>

          <div class="gallery-item tall reveal">
            <Image
              src={singlingB}
              alt="Adhyatamjot Singh hosting a DJ Based Band with a microphone"
              width={480}
              height={620}
              loading="lazy"
            />
            <div class="gallery-caption">
              <span class="label">Hosting a DJ Based Band</span>
              <span class="pill-tag">Weddings</span>
            </div>
          </div>

        </div>

        <a
          class="btn btn-primary"
          id="see-more-btn"
          href={CONTACT.instagram}
          target="_blank"
          rel="noopener noreferrer"
          style="margin: 30px auto !important; display:block; text-align:center;"
        >
          See more videos &amp; photos on Instagram
        </a>
      </div>
    </section>


    <!-- ABOUT -->
    <section class="section-pad" id="about">
      <div class="container about-grid">
        <div class="reveal">
          <h2 class="section-title">
            A dancer and band performer who now holds the mic.
          </h2>
        </div>

        <div class="reveal about-copy">
          <p>
            I started on stage as a dancer and then spent 50+ shows with a
            DJ-based band, learning how a crowd moves, when to build the
            energy and when to give the room a breather. Hosting is where
            all of that comes together.
          </p>
          <p>
            Since then I've hosted dance competitions and other events. I
            care about two things most: the people in the room feel looked
            after, and the evening runs the way you planned it. That means
            reading your schedule properly, arriving early and speaking to
            your planner, DJ and sound team before the first guest walks in.
          </p>
        </div>
      </div>
    </section>


    <!-- EVENT ROSTER -->
    <section
      class="section-pad"
      style="background:var(--bg-soft); border-block:1px solid var(--panel-border);"
      id="roster"
    >
      <div class="container">

        <h2 class="section-title reveal">
          Events I host
        </h2>

        <p class="section-intro reveal">
          Not sure your event fits? Message me. If I'm not the right host,
          I'll say so.
        </p>

        <div
          style="display:flex; flex-direction:column; gap:14px; margin-top:44px;"
        >
          {
            roster.map((r) => (
              <div class="card roster-row reveal">
                <div class="roster-row-left">
                  <span
                    class="icon-badge"
                    style="margin:0; flex-shrink:0;"
                    set:html={micIcon}
                  />
                  <div>
                    <h3 style="margin-bottom:4px;">{r.title}</h3>
                    <p style="margin:0;">{r.blurb}</p>
                  </div>
                </div>
              </div>
            ))
          }
        </div>

      </div>
    </section>


    <!-- WHY ME -->
    <section class="section-pad" id="why-me">
      <div class="container">

        <h2 class="section-title reveal">
          Why people book me
        </h2>

        <div class="card-grid cols-3" style="margin-top:44px;">

          <div class="card reveal">
            <h3>Three languages, one mic</h3>
            <p>
              Hindi, English and Punjabi, so every table is included, from
              grandparents to the friends who came for the dance floor.
            </p>
          </div>

          <div class="card reveal">
            <h3>A performer's instinct</h3>
            <p>
              Dancing and band shows taught me to read a crowd's energy and
              change the pace in the moment.
            </p>
          </div>

          <div class="card reveal">
            <h3>Easy to work with</h3>
            <p>
              I read the run-of-show, check in before the event and keep to
              time, so planners and families know what to expect.
            </p>
          </div>

        </div>

      </div>
    </section>


    <!-- HOW IT WORKS -->
    <section
      class="section-pad"
      style="background:var(--bg-soft); border-block:1px solid var(--panel-border);"
      id="how-it-works"
    >
      <div class="container">

        <h2 class="section-title reveal">
          How booking works
        </h2>

        <ol class="steps">
          {
            steps.map((s, i) => (
              <li class="card reveal">
                <span class="step-n">{i + 1}</span>
                <h3>{s.title}</h3>
                <p>{s.text}</p>
              </li>
            ))
          }
        </ol>

      </div>
    </section>


    <!-- FAQ -->
    <section class="section-pad" id="faq">
      <div class="container faq-wrap">

        <h2 class="section-title reveal">
          Questions people ask before booking
        </h2>

        <div class="faq-list">
          {
            faqs.map((f) => (
              <details class="card reveal">
                <summary>{f.q}</summary>
                <p>{f.a}</p>
              </details>
            ))
          }
        </div>

      </div>
    </section>


    <!-- CTA -->
    <section class="cta-band curtain">

      <div class="container reveal">

        <h2>Planning a sangeet, wedding or corporate night?</h2>

        <p>
          Tell me the date, the city and the crowd, and I'll tell you if I'm
          free. You'll usually hear back the same day.
        </p>

        <a
          class="btn btn-primary"
          href={waLink(bookMsg)}
          style="margin-top:30px;"
        >
          Message me on WhatsApp
        </a>

      </div>

    </section>


    <!-- CONTACT -->
    <section
      class="cta-band"
      id="contact"
      aria-labelledby="contact-title"
    >

      <div class="container reveal">

        <h2 id="contact-title">Prefer another way to reach me?</h2>

        <p>Email, Instagram or WhatsApp all work. I reply to all three.</p>

        <address
          class="contact-grid"
          style="max-width:720px; margin-inline:auto; text-align:left; font-style:normal;"
        >

          <a
            class="contact-card"
            href={CONTACT.instagram}
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="contact-left">
              <span class="contact-icon" set:html={instagramIcon} />
              <span>
                <span class="title">Instagram</span>
                <span class="value">@addy_khatri01</span>
              </span>
            </span>
          </a>

          <a
            class="contact-card"
            href={CONTACT.liveSite}
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="contact-left">
              <span class="contact-icon">
                <svg
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  aria-hidden="true"
                >
                  <circle cx="12" cy="12" r="10" />
                  <path d="M2 12h20" />
                  <path d="M12 2a15.3 15.3 0 0 1 0 20 15.3 15.3 0 0 1 0-20Z" />
                </svg>
              </span>
              <span>
                <span class="title">Website</span>
                <span class="value">adhyatamjot-singh.eu.org</span>
              </span>
            </span>
          </a>

          <a class="contact-card" href={mailLink("Event hosting enquiry")}>
            <span class="contact-left">
              <span class="contact-icon">
                <svg
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  aria-hidden="true"
                >
                  <rect x="2" y="4" width="20" height="16" rx="2" />
                  <path d="m2 7 10 6 10-6" />
                </svg>
              </span>
              <span>
                <span class="title">Email</span>
                <span class="value">{CONTACT.email}</span>
              </span>
            </span>
          </a>

          <a
            class="contact-card"
            href={waLink(bookMsg)}
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="contact-left">
              <span class="contact-icon">
                <svg
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  aria-hidden="true"
                >
                  <path d="M17.5 14.4c-.3-.1-1.7-.8-1.9-.9-.3-.1-.4-.1-.6.1-.2.3-.7.9-.8 1-.2.2-.3.2-.5.1-.3-.1-1.2-.4-2.3-1.4-.8-.7-1.4-1.6-1.6-1.9-.2-.3 0-.5.1-.6l.4-.5c.1-.1.2-.3.2-.4.1-.1.1-.3 0-.4-.1-.1-.6-1.4-.8-1.9-.2-.5-.4-.4-.6-.4h-.5c-.2 0-.5.1-.7.3-.3.3-1 1-1 2.3 0 1.4 1 2.7 1.1 2.9.1.2 2 3.1 4.9 4.3.7.3 1.2.5 1.7.6.7.2 1.3.2 1.8.1.5-.1 1.7-.7 1.9-1.3.2-.7.2-1.2.2-1.3-.1-.2-.3-.3-.6-.4Z" />
                  <path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Z" />
                </svg>
              </span>
              <span>
                <span class="title">WhatsApp</span>
                <span class="value">Start a chat</span>
              </span>
            </span>
          </a>

          <div
            class="contact-card"
            style="cursor:default; grid-column:1 / -1;"
          >
            <span class="contact-left">
              <span class="contact-icon">
                <svg
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  aria-hidden="true"
                >
                  <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" />
                  <circle cx="12" cy="10" r="3" />
                </svg>
              </span>
              <span>
                <span class="title">Based in</span>
                <span class="value">{CONTACT.base}. Travels across India.</span>
              </span>
            </span>
          </div>

        </address>

